# Copy to `.env` / `.env.local` for local development.
VITE_API_BASE_URL=http://localhost:8000

# Public site origin for canonical / Open Graph absolute URLs (no trailing slash).
VITE_SITE_URL=https://myticket.sa

# StackLogger — never commit the real application key.
# Origin must match the domain saved in StackLogger application settings
# (browser sends Origin automatically from the page host; keep this aligned).
VITE_STACKLOGGER_KEY=
VITE_STACKLOGGER_ORIGIN=https://myticket.sa
# Optional overrides:
# VITE_STACKLOGGER_INGEST_URL=https://ingest.stacklogger.io/v0.1/errors/ingest
# VITE_APP_ENV=production
# VITE_APP_RELEASE=2026.05.23-1
# VITE_APP_REGION=sa
