# Copy to `.env` / `.env.local` for local development.
VITE_API_BASE_URL=http://localhost:8000

# Reverb chat socket — public app key; auth endpoint requires a signed-in bearer token.
VITE_REVERB_HOST=72.62.58.90
VITE_REVERB_PORT=8080
# HTTPS deployments need a TLS-terminated WebSocket proxy for Reverb.
# Set these to that proxy; the current :8080 listener only accepts plain WS.
# VITE_REVERB_WSS_HOST=socket.example.com
# VITE_REVERB_WSS_PORT=443
VITE_REVERB_APP_KEY=sry9zdwkcpgoysehvozr
VITE_REVERB_AUTH_ENDPOINT=https://api.myticket.sa/broadcasting/auth
# Leave unset to use WSS on HTTPS pages and WS on local HTTP pages.
# VITE_REVERB_FORCE_TLS=true

# Public site origin for canonical / Open Graph absolute URLs (no trailing slash).
VITE_SITE_URL=https://myticket.sa

# StackLogger — never commit the real application key.
# Origin must match the domain saved in StackLogger application settings
# (browser sends Origin automatically from the page host; keep this aligned).
VITE_STACKLOGGER_KEY=
VITE_STACKLOGGER_ORIGIN=https://myticket.sa
# Optional overrides:
# VITE_STACKLOGGER_INGEST_URL=https://ingest.stacklogger.io/v0.1/errors/ingest
# VITE_APP_ENV=production
# VITE_APP_RELEASE=2026.05.23-1
# VITE_APP_REGION=sa
